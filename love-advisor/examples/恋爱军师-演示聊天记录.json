    { "sender": "demo-zhou", "accountName": "周予安", "timestamp": 1787401800, "type": 0, "content": "这周六下午你有空吗？想请你喝上次那家咖啡。", "platformMessageId": "demo-009" },
    { "sender": "demo-lin", "accountName": "林小雨", "timestamp": 1787402160, "type": 0, "content": "周六白天要陪家人看医生，晚上可能可以。", "platformMessageId": "demo-010" },
